  <!-- Type. Sizes match the vanilla brushes these replace so no layout shifts. -->

  <Brush Name="CSR.Text.Title" Font="Galahad" TextHorizontalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#FFDA00FF" FontSize="30" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
    </Styles>
  </Brush>

  <Brush Name="CSR.Text.Heading" Font="Galahad" TextHorizontalAlignment="Left">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#FFDA00FF" FontSize="22" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
