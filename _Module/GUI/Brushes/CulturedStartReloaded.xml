<?xml version="1.0" encoding="utf-8"?>
<!--
  The single palette declaration site for this mod.
  Every color the mod draws is defined here; no prefab carries a literal hex.
  Names and values: Obsidian Black #000000, Forged Gold #FFDA00,
  Warm Gold Shadow #C9A800, Soft Champagne #FFF1B3, Steel Gray #A6A6A6,
  Deep Graphite #1A1A1A, hairline #333333, raised #2E2E2E, raised hover #3D3D3D,
  disabled text #6E6E6E. Fonts stay the game's own.
-->
<Brushes>

  <!-- Surfaces -->

  <Brush Name="CSR.Scrim">
    <Layers>
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#000000B8" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Fill" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Panel">
    <Layers>
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#1A1A1AFF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Fill" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Well">
    <Layers>
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#2E2E2EFF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Fill" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Hairline">
    <Layers>
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#333333FF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Fill" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Accent">
    <Layers>
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#FFDA00FF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Fill" />
      </Style>
    </Styles>
  </Brush>

  <!-- Controls -->

  <Brush Name="CSR.Button.Primary" TransitionDuration="0.16">
    <Layers>
      <BrushLayer Name="Rest" Sprite="BlankWhiteSquare_9" Color="#FFDA00FF" />
      <BrushLayer Name="Hover" Sprite="BlankWhiteSquare_9" Color="#C9A800FF" IsHidden="true" />
      <BrushLayer Name="Off" Sprite="BlankWhiteSquare_9" Color="#2E2E2EFF" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Rest" IsHidden="false" />
        <BrushLayer Name="Hover" IsHidden="true" />
        <BrushLayer Name="Off" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
        <BrushLayer Name="Off" IsHidden="true" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" ColorFactor="0.8" />
        <BrushLayer Name="Off" IsHidden="true" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
        <BrushLayer Name="Off" IsHidden="true" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="true" />
        <BrushLayer Name="Off" IsHidden="false" />
      </Style>
    </Styles>
  </Brush>

  <!-- Destructive actions: Alert Amber #FFB000 with black text, section 5's Danger button -->
  <Brush Name="CSR.Button.Danger" TransitionDuration="0.16">
    <Layers>
      <BrushLayer Name="Rest" Sprite="BlankWhiteSquare_9" Color="#FFB000FF" />
      <BrushLayer Name="Hover" Sprite="BlankWhiteSquare_9" Color="#CC8D00FF" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Rest" IsHidden="false" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" ColorFactor="0.8" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Rest" IsHidden="false" AlphaFactor="0.5" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Button.Secondary" TransitionDuration="0.16">
    <Layers>
      <BrushLayer Name="Rest" Sprite="BlankWhiteSquare_9" Color="#2E2E2EFF" />
      <BrushLayer Name="Hover" Sprite="BlankWhiteSquare_9" Color="#3D3D3DFF" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Rest" IsHidden="false" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Rest" IsHidden="false" ColorFactor="0.8" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Rest" IsHidden="false" AlphaFactor="0.6" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Row" TransitionDuration="0.16">
    <Layers>
      <BrushLayer Name="Rest" Sprite="BlankWhiteSquare_9" Color="#1A1A1AFF" />
      <BrushLayer Name="Hover" Sprite="BlankWhiteSquare_9" Color="#3D3D3DFF" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Rest" IsHidden="false" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Rest" IsHidden="false" ColorFactor="0.8" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Rest" IsHidden="true" />
        <BrushLayer Name="Hover" IsHidden="false" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Rest" IsHidden="false" AlphaFactor="0.6" />
        <BrushLayer Name="Hover" IsHidden="true" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="CSR.Pip" TransitionDuration="0.16">
